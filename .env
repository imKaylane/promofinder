# ─── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://techdeals:techdeals@localhost:5432/techdeals

# ─── Security ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Mercado Livre ───────────────────────────────────────────────────────────────
MELI_CLIENT_ID=your_client_id_here
MELI_CLIENT_SECRET=your_client_secret_here
MELI_REDIRECT_URI=http://localhost:8000/api/v1/auth/meli/callback
MELI_SITE_ID=MLB

# ─── AI Provider ────────────────────────────────────────────────────────────────
# Supported: openai | watsonx | disabled
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# IBM watsonx (if AI_PROVIDER=watsonx)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# ─── Redis / Celery ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# ─── Rate limiting ───────────────────────────────────────────────────────────────
MELI_MAX_REQUESTS_PER_MINUTE=60
MELI_CACHE_TTL_SECONDS=300
