# ─── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://techdeals:techdeals@db:5432/techdeals

# ─── Security ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Mercado Livre ───────────────────────────────────────────────────────────────
MELI_CLIENT_ID=your_client_id_here
MELI_CLIENT_SECRET=your_client_secret_here
# Use the public frontend URL when using a tunnel; register this exact URI with Mercado Livre.
MELI_REDIRECT_URI=http://localhost:5173/auth/mercadolivre/callback
MELI_SITE_ID=MLB
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ─── AI Provider ────────────────────────────────────────────────────────────────
# Gemini is optional; Mercado Livre live search works without it.
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
MELI_COLLECTION_QUERIES=placa de video,processador,memoria ram,ssd nvme,perifericos gamer,monitor gamer,mouse gamer,teclado mecanico

# ─── Redis / Celery ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
LOG_LEVEL=INFO

# ─── Rate limiting ───────────────────────────────────────────────────────────────
MELI_MAX_REQUESTS_PER_MINUTE=60
MELI_CACHE_TTL_SECONDS=300
