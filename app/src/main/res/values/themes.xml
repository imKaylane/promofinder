<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme using Material3 Dark -->
    <style name="Base.Theme.PromoFinder" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/green_accent</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/green_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <item name="colorSecondary">@color/green_accent</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.PromoFinder" parent="Base.Theme.PromoFinder" />
</resources>
