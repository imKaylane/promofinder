# GestãoPro — Configurações de ambiente
# Copie este arquivo para .env e ajuste os valores ANTES de executar
# NUNCA versione o arquivo .env

# ── Flask ──────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=true

# SECRET_KEY: gere com: python -c "import secrets; print(secrets.token_hex(32))"
# OBRIGATÓRIO em produção (FLASK_ENV=production)
SECRET_KEY=CHANGE-ME-gestaopro-dev-only-not-for-production

# ── MySQL ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=gestaopro
DB_PASSWORD=CHANGE-ME-senha-do-banco
DB_NAME=gestaopro

# ── JWT ────────────────────────────────────────────────────
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_DAYS=7

# ── CORS (origens separadas por vírgula) ───────────────────
# Descomente e ajuste para o front separado (porta 5500):
# CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
