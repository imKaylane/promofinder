# GestãoPro — Configurações
# Copie este arquivo para .env e ajuste os valores

# Flask
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=gestaopro-secret-key-change-in-production

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=gestaopro
DB_PASSWORD=gestaopro
DB_NAME=gestaopro

# JWT
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_DAYS=7
